{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"target": "ESNext",
		"types": ["rolldown-plugin-wasm/types"],
		"moduleResolution": "bundler",
		"sourceMap": true,
		"declarationMap": true,
		"declaration": true,
		"strict": true,
		"rootDir": "src",
		"allowJs": true,
		"isolatedDeclarations": true
	},
	"exclude": ["tsdown.config.ts", "dist"]
}